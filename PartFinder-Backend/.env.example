# Copy this file to `.env` in the same folder (PartFinder-Backend/.env).
# `.env` is gitignored — never commit real secrets.

# --- Required ---
MONGODB_URI=mongodb+srv://Vercel-Admin-part-finder-AdminDB:GXOR1AD9FzIDMYTr@part-finder-admindb.semhy39.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# Vercel: Project → Settings → Environment Variables → add MONGODB_URI + JWT_SECRET for Production, then Redeploy.
# Root Directory in Vercel must be PartFinder-Backend (not repo root).

# --- Server ---
PORT=3000
# Comma-separated browser origins for CORS (optional in local dev)
CORS_ORIGIN=http://127.0.0.1:5173

# --- Self-serve licence checkout (Razorpay Test Mode, $10 USD) ---
# Get Test Mode keys: https://dashboard.razorpay.com/app/keys
# Use Key ID (public, starts with rzp_test_) and Key Secret (private) from the same Test Mode pair.
# Enable USD / international payments on your Razorpay account if order creation fails on currency.
LICENSE_PURCHASE_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# --- WMS deployment tier (required for safe posting gates) ---
# production | staging | development  (default: development if unset)
# WMS_DEPLOYMENT_TIER=staging
#
# Staging stock posts: tier staging|development AND flag true (ignored on production tier).
# WMS_STAGING_STOCK_POSTING=true
#
# Live stock posts (future): tier production AND flag true only.
# WMS_LIVE_STOCK_POSTING=false
#
# Record preflight on staging (ops CLI — tokens not stored in repo):
#   WMS_API_BASE=https://staging-api.example.com WMS_JWT=<bearer> npm run wms:staging-preflight

# --- Optional: Redis, Elasticsearch, invite email — see existing platform setup ---
