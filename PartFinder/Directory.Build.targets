<Project>
  <PropertyGroup>
    <BuildProjectReferences>true</BuildProjectReferences>
  </PropertyGroup>

  <!--
    WinUI/MSIX define GetLatestMSVCVersion; on some VS installs Exists(MSVC) passes but enumeration throws.
    This repo imports Directory.Build.targets last, so this task replaces the stock implementation.
  -->
  <UsingTask TaskName="GetLatestMSVCVersion"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <MSVCDirectoryPath ParameterType="System.String" Required="true" />
      <LatestMSVCVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
LatestMSVCVersion = string.Empty;
try
{
  if (!string.IsNullOrWhiteSpace(MSVCDirectoryPath) && Directory.Exists(MSVCDirectoryPath))
  {
    var lastDir = Directory.EnumerateDirectories(MSVCDirectoryPath).LastOrDefault();
    LatestMSVCVersion = lastDir != null ? new DirectoryInfo(lastDir).Name : string.Empty;
  }
}
catch
{
  LatestMSVCVersion = string.Empty;
}
]]></Code>
    </Task>
  </UsingTask>

  <!-- Copy MSIX MSBuild task binaries + System.Security.Permissions for Store .msixupload creation on dotnet SDK. -->
  <Target Name="PartFinderStageMsixTaskDependencies"
          BeforeTargets="PrepareForBuild;PrepareMsixPackage"
          Condition="'$(WindowsPackageType)' == 'MSIX' or '$(GenerateAppxPackageOnBuild)' == 'true' or '$(AppxPackage)' == 'true'">
    <PropertyGroup>
      <_SourceMsixTools>$(PkgMicrosoft_Windows_SDK_BuildTools_MSIX)\tools\net6.0\</_SourceMsixTools>
      <_PermissionsDll Condition="Exists('$(PkgSystem_Security_Permissions)\lib\net8.0\System.Security.Permissions.dll')">$(PkgSystem_Security_Permissions)\lib\net8.0\System.Security.Permissions.dll</_PermissionsDll>
      <_PermissionsDll Condition="'$(_PermissionsDll)' == '' and Exists('$(PkgSystem_Security_Permissions)\lib\net462\System.Security.Permissions.dll')">$(PkgSystem_Security_Permissions)\lib\net462\System.Security.Permissions.dll</_PermissionsDll>
    </PropertyGroup>
    <MakeDir Directories="$(_PartFinderMsixTaskDeps)" />
    <ItemGroup Condition="Exists('$(_SourceMsixTools)')">
      <_MsixToolDlls Include="$(_SourceMsixTools)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_MsixToolDlls)"
          DestinationFolder="$(_PartFinderMsixTaskDeps)"
          SkipUnchangedFiles="true"
          Condition="'@(_MsixToolDlls)' != ''" />
    <Copy SourceFiles="$(_PermissionsDll)"
          DestinationFolder="$(_PartFinderMsixTaskDeps)"
          SkipUnchangedFiles="true"
          Condition="'$(_PermissionsDll)' != ''" />
    <!-- MSBuild may load Microsoft.Windows.SDK.BuildTools.MSIX.dll from the package tools folder before our staged path is used; copy the dependency there too. -->
    <Copy SourceFiles="$(_PermissionsDll)"
          DestinationFiles="$(_SourceMsixTools)System.Security.Permissions.dll"
          SkipUnchangedFiles="true"
          Condition="'$(_PermissionsDll)' != '' and Exists('$(_SourceMsixTools)')" />
    <PropertyGroup>
      <MsixTaskAssemblyLocation>$(_PartFinderMsixTaskDeps)</MsixTaskAssemblyLocation>
    </PropertyGroup>
    <Message Importance="high" Text="PartFinder MSIX task deps staged in $(_PartFinderMsixTaskDeps)" />
  </Target>

  <!--
    WinUI imports a target also named GetVCInstallPath; MSBuild merges duplicate targets.
    When VS has no C++ workload, GetLatestMSVCVersion throws on a missing MSVC folder.
    Set sentinel paths so the merged WinUI target skips MSVC probing (managed WinUI app).
  -->
  <Target Name="PartFinderBypassVcInstallWhenNoMsvc"
          BeforeTargets="GetVCInstallPath;_EnsurePdbCmfExeFullPath"
          Condition="'$(VsInstallRoot)' != '' and !Exists('$(VsInstallRoot)\VC\Tools\MSVC')">
    <PropertyGroup>
      <VCInstallPath32 Condition="'$(VCInstallPath32)' == ''">PartFinderNoMsvc</VCInstallPath32>
      <VCInstallPath64 Condition="'$(VCInstallPath64)' == ''">PartFinderNoMsvc</VCInstallPath64>
      <MsPdbCmfExeFullpath Condition="'$(MsPdbCmfExeFullpath)' == ''">PartFinderNoMsvc</MsPdbCmfExeFullpath>
    </PropertyGroup>
  </Target>
</Project>
