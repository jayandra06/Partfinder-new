<Page
    x:Class="PartFinder.Views.Pages.MasterDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PartFinder.Views.Components"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:models="using:PartFinder.Models">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <Style x:Key="ToolbarSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="ToolbarConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarSegmentButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="MasterDataPageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="CatalogNavListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="20" Background="Transparent" Transitions="{StaticResource LuxuryPanelTransitions}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CatalogNavColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="CatalogSidebar"
            Grid.Column="0"
            MinWidth="200"
            MaxWidth="260"
            Margin="0,0,16,0"
            Padding="12,16"
            Background="{StaticResource ShellSidebarBrush}"
            BorderBrush="{StaticResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="CATALOG"
                            FontSize="10"
                            FontWeight="Bold"
                            CharacterSpacing="80"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="11"
                            Padding="10,6"
                            MinHeight="32"
                            Click="OnAddCatalogClicked"
                            Visibility="{Binding CanAddMasterDataCatalog, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTipService.ToolTip="Add a new master data catalog">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                                <TextBlock Text="Add" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="CatalogListView"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemsSource="{Binding DataTemplates}"
                        SelectedItem="{Binding SelectedDataTemplate, Mode=TwoWay}"
                        ContainerContentChanging="OnCatalogContainerContentChanging"
                        ItemContainerStyle="{StaticResource CatalogNavListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PartTemplateDefinition">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Name}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        TextWrapping="WrapWholeWords"
                                        VerticalAlignment="Center" />
                                    <Button
                                        x:Name="CatalogDeleteButton"
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Margin="0,0,4,0"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource DangerBrush}"
                                        BorderThickness="1"
                                        Click="OnCatalogDeleteClick"
                                        Visibility="Collapsed"
                                        ToolTipService.ToolTip="Delete catalog">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource DangerBrush}" />
                                    </Button>
                                    <Button
                                        x:Name="CatalogFavouriteButton"
                                        Grid.Column="2"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        Click="OnCatalogFavouriteClick"
                                        ToolTipService.ToolTip="Add to favourites">
                                        <FontIcon x:Name="CatalogFavouriteIcon" Glyph="&#xE734;" FontSize="11" Foreground="#FFC107" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="MainContentPane" Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>

        <Button
            x:Name="BackFromEditButton"
            Grid.Row="0"
            Style="{StaticResource GhostButtonStyle}"
            Padding="8,4"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Click="OnBackFromEditClick"
            Visibility="{Binding ShowSpreadsheetEditChrome, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                <TextBlock Text="Back to template data" FontSize="12" />
            </StackPanel>
        </Button>

        <Grid x:Name="PageTitleHeaderGrid" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="StandalonePageTitlePanel"
                Grid.Column="0"
                Spacing="4"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmbeddedLinkedBrowse, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <TextBlock Text="Master Data" Style="{StaticResource MasterDataPageTitleStyle}" />
                <TextBlock
                    Text="{Binding SelectedDataTemplate.Name}"
                    FontSize="12"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding ShowTemplatePickerInChrome, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="{Binding ShowImportExportToolbar, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button
                    Style="{StaticResource OutlinedButtonStyle}"
                    Height="40"
                    Padding="14,0"
                    Click="OnExportTemplateClicked"
                    ToolTipService.ToolTip="Export catalog data to Excel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE898;" FontSize="13" />
                        <TextBlock Text="Export data" FontSize="13" />
                    </StackPanel>
                </Button>

                <Button
                    Style="{StaticResource OutlinedButtonStyle}"
                    Height="40"
                    Padding="14,0"
                    Click="OnImportExcelClicked"
                    IsEnabled="{Binding CanImportMasterData}"
                    ToolTipService.ToolTip="Import catalog data from Excel or CSV (row 1 = column names)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="13" />
                        <TextBlock Text="Import data" FontSize="13" />
                    </StackPanel>
                </Button>

                <Button
                    Style="{StaticResource DangerOutlinedButtonStyle}"
                    Height="40"
                    Padding="14,0"
                    Click="OnPurgeMasterDataClicked"
                    Visibility="{Binding CanPurgeMasterDataForTemplate, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTipService.ToolTip="Delete all data rows for this template (admin only). The template columns are kept.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Delete data" FontSize="13" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="{Binding ShowSpreadsheetEditChrome, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="16,8"
                    MinHeight="40"
                    Click="OnSaveGridClicked"
                    Visibility="{Binding ShowSpreadsheetManualSaveButton, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTipService.ToolTip="Save grid data">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="13" />
                        <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button
                    Style="{StaticResource GhostButtonStyle}"
                    Padding="14,8"
                    MinHeight="40"
                    Click="OnCancelEditClicked"
                    ToolTipService.ToolTip="Discard changes and exit edit mode">
                    <TextBlock Text="Cancel" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,6" Spacing="6" Visibility="{Binding IsEmbeddedLinkedBrowse, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
            <Border
                Padding="14,10"
                CornerRadius="12"
                Background="{StaticResource ElevatedCardBackgroundBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}"
                BorderThickness="1"
                Visibility="{Binding ShowOperationProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        IsActive="True" />
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding OperationProgressHeadline}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextWrapping="WrapWholeWords" />
                        <ProgressBar
                            Height="10"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding OperationProgressPercent, Mode=OneWay}"
                            Foreground="{StaticResource AccentPrimaryBrush}" />
                        <TextBlock
                            Text="{Binding OperationProgressDetail}"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        MinWidth="52"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentPrimaryBrush}"
                        Text="{Binding OperationProgressPercentLabel}" />
                </Grid>
            </Border>
            <!-- Status messages -->
            <StackPanel Spacing="4">
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{Binding StatusMessage}"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    Text="Select a catalog from the sidebar to view its data. This page is read-only."
                    Visibility="{Binding ShowMasterDataReadOnlyHint, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    TextWrapping="WrapWholeWords"
                    Text="Excel-style setup: type column names in the highlighted header row, fill cells below, or use Import data. Changes save automatically."
                    Visibility="{Binding ShowCatalogCanvasToolbar, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    Text="Use Export data and Import data in the toolbar. Click the search icon on a column header to filter that column."
                    Visibility="{Binding ShowImportExportToolbar, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    Text="Edit mode: use Add row / Add column below the table, delete rows with ×, remove columns from headers, then Save."
                    Visibility="{Binding ShowSpreadsheetEditChrome, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel
                Spacing="10"
                Visibility="{Binding ShowNoMasterDataCatalogsInList, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="13"
                    Text="No master data catalogs yet."
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{StaticResource TextTertiaryBrush}"
                    FontSize="11"
                    Text="Create a catalog, name your columns, and add or import rows."
                    TextWrapping="Wrap" />
                <Button
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="12"
                    Padding="14,10"
                    HorizontalAlignment="Left"
                    Click="OnAddCatalogClicked"
                    Visibility="{Binding ShowEmptyMasterDataAddButton, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="Add master data" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock
                Foreground="{StaticResource TextSecondaryBrush}"
                FontSize="11"
                Text="No tenant database is configured. Complete setup with a valid organisation and database connection."
                TextWrapping="Wrap"
                Visibility="{Binding ShowNoDatabaseHint, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Spreadsheet, linked-column view, and the Linked data panel -->
        <Grid
            x:Name="DataWorkspace"
            Grid.Row="3"
            Margin="0,4,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourceTableColumn" Width="*" />
                <ColumnDefinition x:Name="LinkedViewColumn" Width="0" />
                <ColumnDefinition x:Name="ActionResultsColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="SourceTableHost" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource ElevatedCardBackgroundBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="0">
                    <Grid>
                        <ContentControl
                            x:Name="SpreadsheetHost"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                        <Border
                            Background="{StaticResource ElevatedCardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="16"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <components:LoadingSkeleton Kind="Table" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="10">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{Binding ShowCatalogCanvasChrome, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,8"
                            Command="{Binding AddRowCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add row" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{Binding ShowSpreadsheetEditChrome, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="16,8"
                            Command="{Binding AddRowCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add row" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button
                            Style="{StaticResource OutlinedButtonStyle}"
                            Padding="16,8"
                            Click="OnShowAddColumnPanelClick"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add column" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Button
                            x:Name="MasterDataPrevPageButton"
                            Content="Previous"
                            IsEnabled="False"
                            Style="{StaticResource OutlinedButtonStyle}"
                            Click="OnMasterDataPrevPageClick" />
                        <TextBlock
                            x:Name="MasterDataPageStatusText"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12"
                            Text="No rows" />
                        <Button
                            x:Name="MasterDataNextPageButton"
                            Content="Next"
                            IsEnabled="False"
                            Style="{StaticResource OutlinedButtonStyle}"
                            Click="OnMasterDataNextPageClick" />
                    </StackPanel>
                    </Grid>

                    <Border
                        x:Name="AddColumnPanel"
                        Padding="12,10"
                        CornerRadius="12"
                        Background="{StaticResource ElevatedCardBackgroundBrush}"
                        BorderBrush="{StaticResource GlassStrokeBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsAddColumnPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="280" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NewColumnNameBox"
                                Style="{StaticResource StandardTextBoxStyle}"
                                PlaceholderText="New column name"
                                IsEnabled="{Binding CanManageColumns}"
                                KeyDown="OnNewColumnNameKeyDown" />
                            <ComboBox
                                x:Name="InsertAfterColumnCombo"
                                Grid.Column="1"
                                VerticalAlignment="Stretch"
                                FontSize="12"
                                DisplayMemberPath="Label"
                                IsEnabled="{Binding CanManageColumns}"
                                PlaceholderText="Insert position" />
                            <Button
                                Grid.Column="2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,8"
                                IsEnabled="{Binding CanManageColumns}"
                                Click="OnAddColumnClick"
                                ToolTipService.ToolTip="Add column">
                                <TextBlock Text="Add column" FontSize="12" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="14,8"
                                Click="OnHideAddColumnPanelClick"
                                Content="Cancel" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Border
                x:Name="LinkedViewPanel"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="14"
                Visibility="Collapsed"
                CornerRadius="16"
                Background="{StaticResource ElevatedCardBackgroundBrush}"
                BorderBrush="{StaticResource AccentPrimaryBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="LinkedViewTitleText"
                            FontSize="14"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="✕"
                            FontSize="12"
                            ToolTipService.ToolTip="Hide linked table"
                            Click="OnCloseLinkedViewClick" />
                    </Grid>
                    <TextBlock
                        x:Name="LinkedViewSubtitleText"
                        Grid.Row="1"
                        Margin="0,4,0,10"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                    <Border
                        Grid.Row="2"
                        CornerRadius="12"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1">
                        <ScrollViewer
                            x:Name="LinkedViewScroll"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalScrollMode="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Border>

            <Border
                x:Name="ActionResultsPanel"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="14"
                Opacity="0"
                Visibility="Collapsed"
                CornerRadius="16"
                Background="{StaticResource ElevatedCardBackgroundBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}"
                BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ActionResultsTransform" X="48" />
                </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="ActionTitleText"
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Linked data"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="✕"
                    FontSize="12"
                    Click="OnCloseActionPanelClick" />

                <TextBlock
                    x:Name="ActionCountText"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,4,0,10"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextWrapping="WrapWholeWords"
                    MaxWidth="420" />

                <TabView
                    x:Name="LinkedDataTabView"
                    Grid.Row="2"
                    CanDragTabs="False"
                    CanReorderTabs="False"
                    IsAddTabButtonVisible="False" />
            </Grid>
            </Border>

            <Canvas
                x:Name="LinkConnectorCanvas"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Path
                    x:Name="LinkConnectorGlow"
                    Stroke="{StaticResource AccentPrimaryBrush}"
                    StrokeThickness="7"
                    Opacity="0.28"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
                <Path
                    x:Name="LinkConnectorPath"
                    Stroke="{StaticResource AccentPrimaryBrush}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
                <Ellipse
                    x:Name="LinkSourceHalo"
                    Width="16"
                    Height="16"
                    Visibility="Collapsed"
                    Stroke="{StaticResource AccentPrimaryBrush}"
                    StrokeThickness="1.5"
                    Fill="Transparent" />
                <Ellipse
                    x:Name="LinkSourceNode"
                    Width="8"
                    Height="8"
                    Visibility="Collapsed"
                    Fill="{StaticResource AccentPrimaryBrush}" />
                <Ellipse
                    x:Name="LinkTargetHalo"
                    Width="16"
                    Height="16"
                    Visibility="Collapsed"
                    Stroke="{StaticResource AccentPrimaryBrush}"
                    StrokeThickness="1.5"
                    Fill="Transparent" />
                <Ellipse
                    x:Name="LinkTargetNode"
                    Width="8"
                    Height="8"
                    Visibility="Collapsed"
                    Fill="{StaticResource AccentPrimaryBrush}" />
            </Canvas>
        </Grid>
        </Grid>
    </Grid>
</Page>



