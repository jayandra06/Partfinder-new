<Page
    x:Class="PartFinder.Views.Pages.UserManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PartFinder.Views.Components"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <!-- Row hover style -->
        <Style x:Key="UserRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowBg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RowHoverBackgroundBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowBg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RowSelectedBackgroundBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="RowBg" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" Transitions="{StaticResource LuxuryPanelTransitions}">

        <!-- â”€â”€ Toast Popup â”€â”€ slide-up notification â”€â”€ -->
        <Border
            x:Name="ToastPopup"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,20,20"
            Padding="14,10"
            CornerRadius="14"
            Background="{StaticResource ElevatedCardBackgroundBrush}"
            BorderBrush="{StaticResource GlassStrongStrokeBrush}"
            BorderThickness="1"
            Opacity="0"
            IsHitTestVisible="False"
            Canvas.ZIndex="99">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="20" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="28" Height="28" CornerRadius="14" Background="#1438D6A4" BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                    <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource SuccessBrush}" />
                </Border>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastTitle" Text="Invite sent" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ToastMessage" Text="User has been invited successfully." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="24,20,24,32" Spacing="20" HorizontalAlignment="Stretch">
                <StackPanel.ChildrenTransitions>
                    <StaticResource ResourceKey="LuxuryListTransitions" />
                </StackPanel.ChildrenTransitions>

                <!-- â”€â”€ Header Row â”€â”€ -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="USERS" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="80" FontWeight="SemiBold" />
                        <TextBlock Text="Team Management" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="Invite team members, assign roles and control which templates each user can access for inventory management."
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnInviteClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FA;" FontSize="13" />
                            <TextBlock Text="Invite User" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- â”€â”€ KPI Summary Cards â”€â”€ -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Total users -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Translation="0,0,32">
                            <Border.Shadow><ThemeShadow/></Border.Shadow>
                            <StackPanel Spacing="4">
                            <TextBlock Text="TOTAL USERS" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{StaticResource AccentPrimaryBrush}" />
                                <TextBlock Text="{Binding TotalUsersCount}" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Active -->
                    <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Translation="0,0,32">
                            <Border.Shadow><ThemeShadow/></Border.Shadow>
                            <StackPanel Spacing="4">
                            <TextBlock Text="ACTIVE" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveUsersCount}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Admins -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Translation="0,0,32">
                            <Border.Shadow><ThemeShadow/></Border.Shadow>
                            <StackPanel Spacing="4">
                            <TextBlock Text="ADMINS" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7EF;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="{Binding AdminUsersCount}" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Pending -->
                    <Border Grid.Column="3" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Translation="0,0,32">
                            <Border.Shadow><ThemeShadow/></Border.Shadow>
                            <StackPanel Spacing="4">
                            <TextBlock Text="PENDING" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{StaticResource InfoBrush}" />
                                <TextBlock Text="{Binding PendingUsersCount}" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Search, filters, and user table (single card — no gap between search and grid) -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Translation="0,0,32">
                    <Border.Shadow><ThemeShadow /></Border.Shadow>
                    <StackPanel Spacing="0">
                        <Grid
                            Padding="12,10"
                            ColumnSpacing="8"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="128" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBox
                                    Grid.Column="1"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    PlaceholderText="Search users..."
                                    FontSize="12"
                                    VerticalContentAlignment="Center"
                                    Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                ItemsSource="{Binding RoleFilters}"
                                SelectedItem="{Binding SelectedRoleFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                ItemsSource="{Binding StatusFilters}"
                                SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock
                            Padding="12,6"
                            Foreground="{StaticResource DangerBrush}"
                            Text="{Binding StatusMessage}"
                            FontSize="12"
                            TextWrapping="WrapWholeWords"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                        <!-- Table Header (full width; column defs match rows below) -->
                        <Grid
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            Padding="12,8"
                            ColumnSpacing="12"
                            Background="{StaticResource GridHeaderBackgroundBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="1*" MinWidth="160" />
                                <ColumnDefinition Width="2*" MinWidth="180" />
                                <ColumnDefinition Width="1*" MinWidth="120" />
                                <ColumnDefinition Width="1*" MinWidth="120" />
                                <ColumnDefinition Width="1*" MinWidth="120" />
                                <ColumnDefinition Width="1*" MinWidth="120" />
                                <ColumnDefinition Width="1*" MinWidth="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="NAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="EMAIL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="ROLE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="ACCESS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="INVITED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="ACTIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" CharacterSpacing="60" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
                        </Grid>

                        <!-- Table Rows -->
                        <ListView
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            ItemsSource="{Binding Users}"
                            SelectionMode="None"
                            ItemContainerStyle="{StaticResource UserRowItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        HorizontalAlignment="Stretch"
                                        Padding="12,8"
                                        ColumnSpacing="12"
                                        MinHeight="44"
                                        BorderBrush="{StaticResource BorderDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="1*" MinWidth="160" />
                                            <ColumnDefinition Width="2*" MinWidth="180" />
                                            <ColumnDefinition Width="1*" MinWidth="120" />
                                            <ColumnDefinition Width="1*" MinWidth="120" />
                                            <ColumnDefinition Width="1*" MinWidth="120" />
                                            <ColumnDefinition Width="1*" MinWidth="120" />
                                            <ColumnDefinition Width="1*" MinWidth="120" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border
                                            Grid.Column="0"
                                            Width="28" Height="28"
                                            HorizontalAlignment="Center"
                                            CornerRadius="14"
                                            Background="{StaticResource AccentPrimaryBrush}"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding Initials}" />
                                        </Border>

                                        <!-- Name -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- Email -->
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding Email}"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- Role Badge (fit to label, centered in column) -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border
                                                HorizontalAlignment="Center"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Background="#1A2B43">
                                                <TextBlock
                                                    Text="{Binding Role}"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource AccentPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Status -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border
                                                HorizontalAlignment="Center"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Background="#1A38D6A4"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Active" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                            </Border>
                                            <Border
                                                HorizontalAlignment="Center"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Background="#33FFC98D"
                                                Visibility="{Binding IsActive, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                                <TextBlock Text="Pending" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Access -->
                                        <TextBlock
                                            Grid.Column="5"
                                            Text="{Binding PartsScopeDisplay}"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="2"
                                            TextWrapping="WrapWholeWords" />

                                        <!-- Invited date -->
                                        <TextBlock
                                            Grid.Column="6"
                                            Text="{Binding InvitedAtDisplay}"
                                            FontSize="10"
                                            Foreground="{StaticResource TextTertiaryBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- Actions (overflow menu) -->
                                        <Button
                                            Grid.Column="7"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="OnUserActionsButtonClick"
                                            ToolTipService.ToolTip="More actions">
                                            <!-- Stacked dots: font glyphs map differently across MDL2/Fluent; this is always vertical -->
                                            <Viewbox
                                                Width="14"
                                                Height="14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <StackPanel Orientation="Vertical" Spacing="3">
                                                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource TextSecondaryBrush}" />
                                                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource TextSecondaryBrush}" />
                                                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Loading -->
                        <components:LoadingSkeleton
                            Grid.Row="2"
                            Kind="Table"
                            Margin="12"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

                            </Grid>
                        </ScrollViewer>
                        <components:TablePaginationBar />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>



