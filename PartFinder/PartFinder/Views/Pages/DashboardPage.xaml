<Page
    x:Class="PartFinder.Views.Pages.DashboardPage"
    x:Name="DashboardPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PartFinder.Views.Components"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:viewModels="using:PartFinder.ViewModels">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>

        <!-- In-page dashboard section (no floating card / shadow) -->
        <Style x:Key="DashboardSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0,4,0,22"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="DashboardInsetSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0,6,0,0"/>
        </Style>

        <!-- Quick action rows â€” flat list on the page -->
        <Style x:Key="ActionRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FavouritePreviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FavouritePreviewHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="132"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FavouritePreviewDataCellStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="132"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Auto">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveStates">
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootStack.Padding" Value="12,16,12,32" />
                            
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel x:Name="RootStack" Padding="28,24,28,40" Spacing="18" HorizontalAlignment="Stretch"
                        Transitions="{StaticResource LuxuryPanelTransitions}">

            <!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
            <!-- HEADER                                                         -->
            <!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
            <Grid x:Name="HeaderGrid" Opacity="0" Transitions="{StaticResource LuxuryPanelTransitions}">
                <Grid.RenderTransform><TranslateTransform x:Name="HeaderSlide" Y="-10"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock Text="OVERVIEW" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                               CharacterSpacing="80" FontWeight="SemiBold"/>
                    <TextBlock Text="Home" FontSize="26" FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="{ThemeResource AccentHoverColor}" Offset="0"/>
                                <GradientStop Color="{ThemeResource AccentPrimaryColor}" Offset="0.4"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Live previews of your starred catalogs and analytics templates."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Status badge with animated pulse dot + outer glow -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <!-- Outer pulsing glow halo -->
                    <Border CornerRadius="24" Margin="-6,-4"
                            Background="#1038D6A4" Opacity="0.7"
                            IsHitTestVisible="False"/>
                    <!-- Badge -->
                    <Border CornerRadius="20"
                            Padding="12,7" Background="#1438D6A4" BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <!-- Outer pulse ring -->
                                <Ellipse x:Name="PulseRing" Width="10" Height="10"
                                         Fill="Transparent"
                                         Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.5"
                                         Opacity="0"/>
                                <!-- Solid dot -->
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="SYSTEM ONLINE" FontSize="9" Foreground="{StaticResource SuccessBrush}"
                                       CharacterSpacing="60" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
            <!-- LOW STOCK ALERT BANNER (hidden on home â€” favourites only)      -->
            <!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
            <Border x:Name="LowStockBanner"
                    CornerRadius="12" Padding="16,12"
                    Background="#0DFFB781"
                    BorderThickness="1"
                    Opacity="0"
                    Visibility="Collapsed">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="BannerBorderBrush" Color="#40FFB781"/>
                </Border.BorderBrush>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Warning icon with glow -->
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                            Background="#1AFFB781" VerticalAlignment="Center">
                        <FontIcon x:Name="BannerIcon" Glyph="&#xE7BA;" FontSize="18"
                                  Foreground="#FFB781" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Text + items -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="LOW STOCK ALERT" FontSize="11" FontWeight="Bold"
                                       Foreground="#FFB781" CharacterSpacing="40"/>
                            <Border CornerRadius="4" Padding="5,1" Background="#20FFB781">
                                <TextBlock Text="{Binding LowStockRaw}" FontSize="9"
                                           FontWeight="Bold" Foreground="#FFB781"/>
                            </Border>
                        </StackPanel>

                        <!-- Low stock items as chips -->
                        <ItemsControl ItemsSource="{Binding LowStockItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:LowStockItem">
                                    <Border CornerRadius="6" Padding="8,4" BorderThickness="1">
                                        <Border.Background>
                                            <SolidColorBrush Color="#15FFB781"/>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#30FFB781"/>
                                        </Border.BorderBrush>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{x:Bind Name}" FontSize="10"
                                                       Foreground="#FFB781" FontWeight="SemiBold"/>
                                            <Border CornerRadius="3" Padding="4,1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#25FFB4AB"/>
                                                </Border.Background>
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="8"
                                                           Foreground="#FFB4AB" FontWeight="Bold"
                                                           CharacterSpacing="30"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- View Parts button -->
                    <Button Grid.Column="2" VerticalAlignment="Center"
                            Content="View Parts Ã¢â€ â€™"
                            FontSize="11" FontWeight="SemiBold"
                            Foreground="#FFB781"
                            Background="#15FFB781"
                            BorderBrush="#30FFB781"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6"/>
                </Grid>
            </Border>

            <!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
            <!-- KPI CARDS ROW                                                  -->
            <!-- Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â -->
            <ItemsControl x:Name="KpiRow" ItemsSource="{Binding Kpis}" Visibility="Collapsed"/>

            <!-- YOUR FAVOURITES -->
            <Border x:Name="FavouritesRow" Opacity="0" Style="{StaticResource DashboardSectionStyle}">
                <Border.RenderTransform><TranslateTransform x:Name="FavouritesSlide" Y="8"/></Border.RenderTransform>
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Your Favourites" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Scroll within each card for more columns. Tap the card footer to open the full workspace."
                                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>

                    <components:LoadingSkeleton Kind="Block" Height="120" Margin="0,8,0,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock Text="No favourites yet. Use the star on any catalog or analytics template."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="WrapWholeWords"
                               Visibility="{Binding HasFavourites, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding FavouriteItems}"
                                  Visibility="{Binding HasFavourites, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DashboardFavouriteItem">
                                <Border Style="{StaticResource FavouritePreviewCardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="#FFC107"/>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="17" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border CornerRadius="4" Padding="6,2" Background="#101F7AE0">
                                                        <TextBlock Text="{x:Bind KindLabel}" FontSize="9"
                                                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind SummaryLine}" FontSize="11"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Width="34" Height="34" Padding="0" CornerRadius="8"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                                    ToolTipService.ToolTip="Remove from favourites"
                                                    Click="OnFavouriteRemoveClick"
                                                    Tag="{x:Bind TemplateId}">
                                                <FontIcon Glyph="&#xE711;" FontSize="11"
                                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>

                                        <Border Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="10,8">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled"
                                                          HorizontalScrollMode="Enabled">
                                                <StackPanel Spacing="0" MinWidth="400">
                                                    <ItemsControl ItemsSource="{x:Bind ColumnHeaders}"
                                                                  Visibility="{x:Bind HasPreviewTable, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock Text="{x:Bind}" Style="{StaticResource FavouritePreviewHeaderCellStyle}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Height="1" Margin="0,6,0,4"
                                                            Background="{StaticResource BorderDefaultBrush}"
                                                            Visibility="{x:Bind HasPreviewTable, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                    <TextBlock Text="No columns defined yet."
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{x:Bind HasPreviewTable, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>

                                                    <ItemsControl ItemsSource="{x:Bind PreviewRows}"
                                                                  Visibility="{x:Bind HasRows, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewModels:DashboardFavouritePreviewRow">
                                                                <Border Padding="0,5" BorderBrush="{StaticResource BorderDefaultBrush}"
                                                                        BorderThickness="0,0,0,1">
                                                                    <ItemsControl ItemsSource="{x:Bind Cells}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <TextBlock Text="{x:Bind}" Style="{StaticResource FavouritePreviewDataCellStyle}"/>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="No rows yet — open the workspace to add data."
                                                               FontSize="12" Margin="0,8,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{x:Bind ShowEmptyRowsHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Padding="12,8" CornerRadius="10"
                                                Background="#101F7AE0"
                                                BorderBrush="#301F7AE0" BorderThickness="1"
                                                Click="OnFavouriteOpenClick"
                                                Tag="{x:Bind TemplateId}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Open full workspace" FontSize="12" FontWeight="SemiBold"/>
                                                <FontIcon Glyph="&#xE76C;" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

