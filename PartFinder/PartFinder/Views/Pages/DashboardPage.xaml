<Page
    x:Class="PartFinder.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PartFinder.Views.Components"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:viewModels="using:PartFinder.ViewModels">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer Background="{StaticResource PageBackgroundBrush}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RootStack" Padding="28,22,28,40" Spacing="20" MaxWidth="1440">

            <!-- ═══════════════════════════════════════════════════════════════
                 HEADER — Welcome + Date + Quick Buttons
            ════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="HeaderGrid" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="HeaderSlide" Y="-10"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Greeting, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding TodayDateText, Mode=OneWay}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Top-right quick actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button CornerRadius="8" Padding="12,7"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                            Command="{Binding GoToTemplatesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B5;" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}"/>
                            <TextBlock Text="Import" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="8" Padding="12,7"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                            Command="{Binding GoToSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CE;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 KPI STAT CARDS (like the image: icon + big number + subtitle + delta)
            ════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="KpiRow" ColumnSpacing="14" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="KpiSlide" Y="12"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Parts -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#151F7AE0">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource AccentPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Kpis[0].Value, Mode=OneWay}" FontSize="24" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Total Parts" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Kpis[0].Delta, Mode=OneWay}" FontSize="10" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Low Stock -->
                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#15FFB781">
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#FFB781"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Kpis[1].Value, Mode=OneWay}" FontSize="24" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Low Stock" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Kpis[1].Delta, Mode=OneWay}" FontSize="10" Foreground="#FFB781"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Active Templates -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#152ABD8F">
                                <FontIcon Glyph="&#xE9F9;" FontSize="15" Foreground="{StaticResource SuccessBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Kpis[2].Value, Mode=OneWay}" FontSize="24" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Active Templates" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Kpis[2].Delta, Mode=OneWay}" FontSize="10" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Import Success -->
                <Border Grid.Column="3" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#158B5CF6">
                                <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="#8B5CF6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Kpis[3].Value, Mode=OneWay}" FontSize="24" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Import Success" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Kpis[3].Delta, Mode=OneWay}" FontSize="10" Foreground="#8B5CF6"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 ROW 1: Donut + Bar Chart + Line Chart (3 columns like image)
            ════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="Row1" ColumnSpacing="14" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="Row1Slide" Y="14"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <!-- Donut: Template Distribution -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Parts by Template" FontSize="14" FontWeight="SemiBold"/>
                        <Grid>
                            <lvc:PieChart Height="170" Series="{Binding DistributionSeries, Mode=OneWay}"
                                AnimationsSpeed="00:00:01.0" InitialRotation="-90"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{Binding Kpis[0].Value, Mode=OneWay}" FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Total" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <!-- Legend -->
                        <ItemsControl ItemsSource="{Binding DistributionItems, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DistributionItem">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{x:Bind ColorBrush}" VerticalAlignment="Center"/>
                                            <TextBlock FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                                <Run Text="{x:Bind Percentage}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontSize="9"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Bar Chart: Stock Levels -->
                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Stock Level Summary" FontSize="14" FontWeight="SemiBold"/>
                        <lvc:CartesianChart Height="220" Series="{Binding StockLevelSeries, Mode=OneWay}"
                            AnimationsSpeed="00:00:01.0" EasingFunction="{x:Null}"/>
                    </StackPanel>
                </Border>

                <!-- Line Chart: Parts Trend -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Parts Growth" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastUpdated, Mode=OneWay}" FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <lvc:CartesianChart Height="220" Series="{Binding TrendSeries, Mode=OneWay}"
                                AnimationsSpeed="00:00:01.2" EasingFunction="{x:Null}"/>
                            <ProgressRing Width="20" Height="20" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" IsActive="{Binding IsLoading, Mode=OneWay}"
                                          Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 ROW 2: Activity Table + Quick Actions (2 columns like image)
            ════════════════════════════════════════════════════════════════ -->
            <Grid x:Name="Row2" ColumnSpacing="14" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="Row2Slide" Y="14"/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Activity Table (like Payment vouchers in image) -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Recent Activity" FontSize="14" FontWeight="SemiBold"/>

                        <!-- Table header -->
                        <Grid Padding="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Event" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Status" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderDefaultBrush}"/>

                        <!-- Activity rows -->
                        <ItemsControl ItemsSource="{Binding RecentActivity, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ActivityItem">
                                    <Border Padding="0,8" BorderBrush="{StaticResource BorderDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left">
                                                <Border.Background><SolidColorBrush Color="#10FFFFFF"/></Border.Background>
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="10"
                                                          Foreground="{x:Bind IconBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="#102ABD8F">
                                                <TextBlock Text="Completed" FontSize="10" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Quick Actions Panel -->
                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold"/>
                        <StackPanel Spacing="8">

                            <!-- Navigate to Templates -->
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    CornerRadius="10" Padding="12,10"
                                    Background="{StaticResource ElevatedCardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                    Command="{Binding GoToTemplatesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#121F7AE0">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="New Template" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Create schema" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Navigate to MasterData (Explorer) -->
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    CornerRadius="10" Padding="12,10"
                                    Background="{StaticResource ElevatedCardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                    Command="{Binding GoToExplorerCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#122ABD8F">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="14" Foreground="{StaticResource SuccessBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Explore Data" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Browse parts" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Navigate to Relations -->
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    CornerRadius="10" Padding="12,10"
                                    Background="{StaticResource ElevatedCardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                    Command="{Binding GoToRelationsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#12FEBC2E">
                                        <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="{StaticResource WarningBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Link Templates" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Manage relations" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Navigate to QR Code -->
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    CornerRadius="10" Padding="12,10"
                                    Background="{StaticResource ElevatedCardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                    Command="{Binding GoToQrCodeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#128B5CF6">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="#8B5CF6"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Scan QR Code" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Find part instantly" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Navigate to Settings -->
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    CornerRadius="10" Padding="12,10"
                                    Background="{StaticResource ElevatedCardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                    Command="{Binding GoToSettingsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#12FFB4AB">
                                        <FontIcon Glyph="&#xE8FA;" FontSize="14" Foreground="{StaticResource DangerBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Invite Member" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Team settings" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
