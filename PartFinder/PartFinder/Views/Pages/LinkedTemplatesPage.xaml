<Page
    x:Class="PartFinder.Views.Pages.LinkedTemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PartFinder.Views.Components"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:models="using:PartFinder.Models"
    xmlns:viewmodels="using:PartFinder.ViewModels"
    x:Name="LinkedPageRoot">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="LinkedTemplatesPageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="SidebarSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="4,12,0,8" />
        </Style>
        <Style x:Key="CatalogNavListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Storyboard x:Name="PageEntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="PageRoot"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PageSlideTransform"
                Storyboard.TargetProperty="Y"
                From="14" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid
        x:Name="PageRoot"
        Opacity="0"
        Padding="20"
        Background="Transparent"
        Transitions="{StaticResource LuxuryPanelTransitions}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageSlideTransform" Y="14" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CatalogNavColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="CatalogSidebar"
            Grid.Column="0"
            MinWidth="200"
            MaxWidth="260"
            Margin="0,0,16,0"
            Padding="12,16"
            Background="{StaticResource ShellSidebarBrush}"
            BorderBrush="{StaticResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource SidebarSectionTitleStyle}"
                        Margin="4,0,0,8"
                        Text="LINKED TEMPLATES" />
                    <ListView
                        x:Name="LinkedTemplatesListView"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemsSource="{Binding LinkedSidebarTemplates}"
                        ItemContainerStyle="{StaticResource CatalogNavListViewItemStyle}"
                        SelectionChanged="OnSidebarTemplateSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PartTemplateDefinition">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="None yet"
                        FontSize="11"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Margin="4,0,0,4"
                        Visibility="{Binding HasLinkedSidebarTemplates, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

                    <TextBlock Style="{StaticResource SidebarSectionTitleStyle}" Text="NON-LINKED TEMPLATES" />
                    <ListView
                        x:Name="NonLinkedTemplatesListView"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemsSource="{Binding NonLinkedSidebarTemplates}"
                        ItemContainerStyle="{StaticResource CatalogNavListViewItemStyle}"
                        SelectionChanged="OnSidebarTemplateSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PartTemplateDefinition">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="None"
                        FontSize="11"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Margin="4,0,0,4"
                        Visibility="{Binding HasNonLinkedSidebarTemplates, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="MainContentPane" Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="360" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6" Margin="0,0,0,4">
                <TextBlock Text="Linked Templates" Style="{StaticResource LinkedTemplatesPageTitleStyle}" />
                <TextBlock
                    Text="Browse &amp; link"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock
                    Text="{Binding BrowseSourceTemplateName}"
                    FontSize="12"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding HasBrowseSourceTemplate, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Text="Select a template from the sidebar to view its data. Linked templates (with shared column names) appear in the chip list below."
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextWrapping="WrapWholeWords"
                    MaxWidth="920" />
                <Border
                    Padding="12,10"
                    CornerRadius="10"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{Binding ShowNoTemplatesAvailableMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        Text="No templates available to show."
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                <Border
                    Padding="10,8"
                    CornerRadius="10"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasLinkedTemplatesForBrowse, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Linked templates"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            CharacterSpacing="40" />
                        <ItemsControl ItemsSource="{Binding LinkedTemplatesForBrowse}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:LinkedTemplateBrowseItem">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind TemplateName}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"
                                            Margin="4,0,8,0" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Unlink"
                                            FontSize="11"
                                            MinHeight="32"
                                            Padding="10,6"
                                            Style="{StaticResource DangerOutlinedButtonStyle}"
                                            Visibility="{Binding ElementName=LinkedPageRoot, Path=DataContext.CanUnlinkTemplates, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding ElementName=LinkedPageRoot, Path=DataContext.DeleteLinkCommand}"
                                            CommandParameter="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Frame
                x:Name="BrowseDataFrame"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Visibility="{Binding HasTemplatesToBrowse, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <components:LoadingSkeleton
                    Kind="Inline"
                    Width="140"
                    Height="14"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Text="{Binding ErrorMessage}"
                    FontSize="12"
                    Foreground="{StaticResource DangerBrush}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
