<Page
    x:Class="PartFinder.Views.Pages.LinkedTemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:viewmodels="using:PartFinder.ViewModels"
    xmlns:models="using:PartFinder.Models">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Storyboard x:Name="PageEntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="PageRoot"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PageSlideTransform"
                Storyboard.TargetProperty="Y"
                From="14" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="BrowseListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style x:Key="BrowseTemplateRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GridRowAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="SidePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="PageRoot"
        Opacity="0"
        Padding="24"
        RowSpacing="14"
        Background="Transparent"
        Transitions="{StaticResource LuxuryPanelTransitions}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageSlideTransform" Y="14" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                Text="LINKED TEMPLATES"
                FontSize="10"
                Foreground="{StaticResource AccentPrimaryBrush}"
                CharacterSpacing="120"
                FontWeight="SemiBold" />
            <TextBlock
                Text="View linked templates"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock
                Text="Pick a template, choose a linked template, then set which lookup columns appear when browsing linked rows. Match-key columns stay selected automatically."
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}"
                TextWrapping="WrapWholeWords"
                MaxWidth="920" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="{StaticResource ElevatedCardBackgroundBrush}"
            BorderBrush="{StaticResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Translation="0,0,24">
            <Border.Shadow><ThemeShadow/></Border.Shadow>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="220" />
                    <ColumnDefinition Width="300" MinWidth="260" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Templates -->
                <Border Style="{StaticResource SidePanelStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Templates"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock
                                Text="Your worksheet templates"
                                FontSize="11"
                                Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding Templates}"
                            SelectedItem="{Binding BrowseSourceTemplate, Mode=TwoWay}"
                            SelectionMode="Single"
                            ItemContainerStyle="{StaticResource BrowseListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PartTemplateDefinition">
                                    <Border Style="{StaticResource BrowseTemplateRowStyle}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ColumnCountLabel}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Linked templates (beside list) -->
                <Border Grid.Column="1" Style="{StaticResource SidePanelStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Linked templates"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                TextWrapping="WrapWholeWords">
                                <Run Text="Links from " />
                                <Run Text="{Binding BrowseSourceTemplateName}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBlock
                                Text="Select a template on the left."
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasBrowseSourceTemplate, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                            <TextBlock
                                Text="No links for this template yet. Configure links under Link Templates in the sidebar."
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                TextWrapping="WrapWholeWords"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowNoLinksForBrowseMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ListView
                                ItemsSource="{Binding LinkedTemplatesForBrowse}"
                                SelectedItem="{Binding SelectedLinkedBrowseItem, Mode=TwoWay}"
                                SelectionMode="Single"
                                ItemContainerStyle="{StaticResource BrowseListItemStyle}"
                                Visibility="{Binding HasLinkedTemplatesForBrowse, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:LinkedTemplateBrowseItem">
                                        <Border Style="{StaticResource BrowseTemplateRowStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind TemplateName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="Click to edit view columns" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <!-- View columns + preview -->
                <Border Grid.Column="2" Style="{StaticResource SidePanelStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Columns for viewing"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{Binding HasSelectedLinkedTemplate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="Shown when browsing " />
                                <Run Text="{Binding SelectedLinkedTemplateName}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock
                                Text="Select a linked template to see and edit its view columns."
                                FontSize="11"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Visibility="{Binding ShowColumnEditorPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollMode="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding ShowColumnEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding PreviewColumnPicks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:RelationColumnPickItem">
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="10,8"
                                            CornerRadius="10"
                                            Background="{StaticResource GridRowAltBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsSelectable}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding ColumnName}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Border
                                                    Grid.Column="2"
                                                    Padding="6,2"
                                                    CornerRadius="6"
                                                    Background="#221F7AE0"
                                                    Visibility="{Binding IsAutoMatchKey, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="MATCH KEY" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="{Binding ShowColumnEditorPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE8F1;" FontSize="28" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock
                                Text="No linked template selected"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="10" Visibility="{Binding ShowColumnEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Content="Save view columns"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="36"
                                    Padding="14,0"
                                    Command="{Binding SaveViewColumnsCommand}" />
                                <Button
                                    Content="Preview data"
                                    Style="{StaticResource OutlinedButtonStyle}"
                                    Height="36"
                                    Padding="14,0"
                                    Command="{Binding RefreshPreviewCommand}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding StatusMessage}"
                                FontSize="12"
                                Foreground="{StaticResource AccentPrimaryBrush}"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Visibility="{Binding HasPreviewData, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Border
                                Background="{StaticResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                MinHeight="160"
                                MaxHeight="280"
                                Visibility="{Binding HasPreviewData, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
                                        <ListView ItemsSource="{Binding PreviewRows}" SelectionMode="None" ItemContainerStyle="{StaticResource BrowseListItemStyle}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:LinkedTemplatePreviewRow">
                                                    <Border Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}">
                                                        <ItemsControl ItemsSource="{x:Bind Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="viewmodels:PreviewColumnCell">
                                                                    <StackPanel MinWidth="100" MaxWidth="180" Spacing="2">
                                                                        <TextBlock Text="{x:Bind Header}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" />
                                                                        <TextBlock Text="{x:Bind Value}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </ScrollViewer>
                                    <ProgressRing Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{Binding IsLoadingPreview}" Foreground="{StaticResource AccentPrimaryBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressRing Width="16" Height="16" IsActive="{Binding IsLoading}" Foreground="{StaticResource AccentPrimaryBrush}" />
            <ProgressRing Width="16" Height="16" IsActive="{Binding IsSavingColumns}" Foreground="{StaticResource AccentPrimaryBrush}" />
            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</Page>
