<Page
    x:Class="PartFinder.Views.Pages.WorksheetRelationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:PartFinder.Views.Components"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:viewmodels="using:PartFinder.ViewModels">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Storyboard x:Name="PageEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PageSlideTransform" Storyboard.TargetProperty="Y"
                From="14" To="0" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="ConnectorPulseStoryboard" />
        <Storyboard x:Name="ChipStripFadeStoryboard" />
    </Page.Resources>

    <Grid x:Name="PageRoot" Opacity="0" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageSlideTransform" Y="14" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ TOOLBAR ═══ -->
        <Grid Grid.Row="0" Padding="24,16,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Template Relationships" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressRing Width="14" Height="14" IsActive="{Binding IsLoading}" Foreground="{StaticResource AccentPrimaryBrush}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Background="#101F7AE0" BorderBrush="#301F7AE0" BorderThickness="1"
                        CornerRadius="16" Padding="12,5"
                        Visibility="{Binding HasRelations, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="8" MinWidth="220">
                                <TextBlock Text="Saved Links" FontSize="13" FontWeight="SemiBold" />
                                <Border Height="1" Background="{StaticResource BorderDefaultBrush}" />
                                <ItemsControl ItemsSource="{Binding RelationChips}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:RelationChipItem">
                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="8,10" CornerRadius="6"
                                                    Command="{Binding ElementName=PageRoot, Path=DataContext.SelectRelationCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE71B;" FontSize="12" Foreground="{StaticResource AccentPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}">
                        <Run Text="{Binding RelationCount}" /><Run Text=" Saved Links" />
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}" Content="Reset" FontSize="12"
                        MinHeight="36" Padding="14,6" Command="{Binding ResetCommand}" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save Link" FontSize="12"
                        MinHeight="36" MinWidth="100" Padding="14,6" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <!-- ═══ LINKER CONTENT ═══ -->
        <Grid Grid.Row="1" Padding="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Primary Template columns -->
            <Border x:Name="PrimaryPanel"
                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                    Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Primary Template" FontSize="14" FontWeight="SemiBold" />

                    <ComboBox Grid.Row="1" HorizontalAlignment="Stretch" FontSize="13" MinHeight="38"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding PrimaryTemplate, Mode=TwoWay}" />

                    <ScrollViewer x:Name="PrimaryScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PrimaryColumnList" Spacing="0">
                            <!-- Populated in code-behind with port dots -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER: Connection Canvas (lines drawn here) -->
            <Canvas x:Name="ConnectionCanvas" Grid.Column="1"
                    Background="Transparent"
                    PointerMoved="OnConnectionCanvasPointerMoved"
                    PointerReleased="OnConnectionCanvasPointerReleased"
                    RightTapped="OnConnectionCanvasRightTapped" />

            <!-- RIGHT: Lookup Template columns -->
            <Border x:Name="LookupPanel" Grid.Column="2"
                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                    Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Lookup Template" FontSize="14" FontWeight="SemiBold" />

                    <ComboBox Grid.Row="1" HorizontalAlignment="Stretch" FontSize="13" MinHeight="38"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding LookupTemplate, Mode=TwoWay}" />

                    <ScrollViewer x:Name="LookupScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LookupColumnList" Spacing="0">
                            <!-- Populated in code-behind with port dots -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- No Permission overlay -->
        <components:NoPermissionView x:Name="NoPermissionOverlay" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Page>
