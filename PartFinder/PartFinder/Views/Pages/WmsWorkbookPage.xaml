<Page
    x:Class="PartFinder.Views.Pages.WmsWorkbookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:PartFinder.Services"
    xmlns:viewmodels="using:PartFinder.ViewModels"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:components="using:PartFinder.Views.Components"
    xmlns:models="using:PartFinder.Models"
    x:Name="PageRoot">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
        <converters:WmsSectionEqualsToVisibilityConverter x:Key="SectionVisConverter" />
    </Page.Resources>
    <Grid Padding="16" DataContext="{x:Bind ViewModel, Mode=OneWay}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="6" Margin="0,0,0,12">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Warehouse Workbook" />
            <TextBlock
                Opacity="0.75"
                Text="Excel-style warehouse setup, SKU registry and read-only inventory. All data via NestJS WMS APIs."
                TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox
                    Width="220"
                    ItemsSource="{Binding Warehouses, Mode=OneWay}"
                    SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}"
                    DisplayMemberPath="Name"
                    PlaceholderText="Warehouse" />
                <TextBox
                    Width="240"
                    PlaceholderText="Search…"
                    Text="{Binding InventorySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Command="{Binding ApplySearchCommand}" Content="Search" />
                <Button Command="{Binding RefreshCommand}" Content="Refresh" />
                <Button Command="{Binding RefreshReceivingWorksheetCommand}" Content="Refresh worksheet" />
                <Button Command="{Binding ExportCurrentWorksheetCommand}" Content="Export Excel" />
            </StackPanel>
            <TextBlock Text="{Binding ReceivingGateSummary, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{Binding NavItems, Mode=OneWay}"
            SelectionMode="None"
            BorderBrush="{StaticResource BorderDefaultBrush}"
            BorderThickness="0,0,1,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:WmsWorkbookNavItem">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="8,12,8,4"
                            FontWeight="SemiBold"
                            FontSize="11"
                            Opacity="0.65"
                            Text="{x:Bind GroupTitle}"
                            Visibility="{x:Bind IsGroupHeader, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,6"
                            Command="{Binding DataContext.SelectSectionCommand, ElementName=PageRoot}"
                            CommandParameter="{x:Bind}"
                            Visibility="{x:Bind IsGroupHeader, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind RoadmapPhase}"
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Visibility="{x:Bind IsOperational, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="16,0,0,0">
            <Grid>
                <components:WmsRoadmapPlaceholder
                    Title="{Binding RoadmapTitle, Mode=OneWay}"
                    PhaseLabel="{Binding RoadmapPhase, Mode=OneWay}"
                    Description="{Binding RoadmapDescription, Mode=OneWay}"
                    Visibility="{Binding IsRoadmapSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Grid Visibility="{Binding ShowOperationalWorksheet, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=dashboard}">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Dashboard" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding TransactionProbeSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding CatalogPhaseSummary, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" Text="Stock balances and ledger are read-only. Production inventory posting is not exposed in this UI." />
                </StackPanel>

                <Grid
                    RowDefinitions="Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=warehouse_master}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Width="100" PlaceholderText="Code" Text="{Binding NewWarehouseCode, Mode=TwoWay}" />
                        <TextBox Width="200" PlaceholderText="Name" Text="{Binding NewWarehouseName, Mode=TwoWay}" />
                        <Button Command="{Binding AddWarehouseCommand}" Content="Save" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding Warehouses, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsWarehouseDto">
                                <Grid Padding="8" ColumnSpacing="16" ColumnDefinitions="80,*,80">
                                    <TextBlock Text="{x:Bind Code}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TimeZone}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    RowDefinitions="Auto,Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=locations}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="100" PlaceholderText="Zone" Text="{Binding NewZoneCode, Mode=TwoWay}" />
                            <TextBox Width="160" PlaceholderText="Zone name" Text="{Binding NewZoneName, Mode=TwoWay}" />
                            <Button Command="{Binding AddZoneCommand}" Content="Add zone" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="140" PlaceholderText="Location path" Text="{Binding NewLocationPath, Mode=TwoWay}" />
                            <ComboBox Width="120" SelectedItem="{Binding NewLocationType, Mode=TwoWay}">
                                <x:String>storage</x:String>
                                <x:String>receiving</x:String>
                                <x:String>staging</x:String>
                                <x:String>dispatch</x:String>
                            </ComboBox>
                            <Button Command="{Binding AddLocationCommand}" Content="Add location" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                        <ListView ItemsSource="{Binding Zones, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:WmsZoneDto">
                                    <TextBlock Text="{x:Bind Code}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ListView Grid.Column="1" ItemsSource="{Binding Locations, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:WmsLocationDto">
                                    <TextBlock Text="{x:Bind Path}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <Grid
                    RowDefinitions="Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=stock_owners}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="100" Text="{Binding NewOwnerCode, Mode=TwoWay}" PlaceholderText="Code" />
                        <TextBox Width="200" Text="{Binding NewOwnerName, Mode=TwoWay}" PlaceholderText="Company name" />
                        <Button Command="{Binding AddStockOwnerCommand}" Content="Save" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding StockOwners, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsStockOwnerDto">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    RowDefinitions="Auto,*,Auto"
                    RowSpacing="8"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=sku_registry}">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Register SKU" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="200" Text="{Binding NewSkuDisplayName, Mode=TwoWay}" PlaceholderText="Display name" />
                            <TextBox Width="64" Text="{Binding NewSkuPrimaryUom, Mode=TwoWay}" PlaceholderText="UOM" />
                            <Button Command="{Binding SaveNewSkuCommand}" Content="Save" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                            <Button Command="{Binding CancelSkuDraftCommand}" Content="Cancel" />
                        </StackPanel>
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding SkuRows, Mode=OneWay}" SelectedItem="{Binding SelectedSku, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsSkuDto">
                                <Grid ColumnDefinitions="160,*,64,72" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind SkuId}" FontFamily="Consolas" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PrimaryUom}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    RowDefinitions="Auto,Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=sku_identifiers}">
                    <TextBlock Text="Select a SKU in SKU Registry, then map identifiers." Opacity="0.75" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="160" ItemsSource="{Binding IdentifierNamespaceOptions, Mode=OneWay}" SelectedItem="{Binding IdentifierNamespace, Mode=TwoWay}" />
                        <TextBox Width="160" Text="{Binding IdentifierValue, Mode=TwoWay}" PlaceholderText="Value" />
                        <TextBox Width="140" Text="{Binding IdentifierManufacturer, Mode=TwoWay}" PlaceholderText="Manufacturer" />
                        <Button Command="{Binding AddIdentifierCommand}" Content="Save" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="2" ItemsSource="{Binding IdentifierRows, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsSkuIdentifierDto">
                                <TextBlock>
                                    <Run Text="{x:Bind Namespace}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind Value}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    RowDefinitions="Auto,*,Auto"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=uom}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="80" Text="{Binding NewUomCode, Mode=TwoWay}" PlaceholderText="Code" />
                        <TextBox Width="200" Text="{Binding NewUomName, Mode=TwoWay}" PlaceholderText="Name" />
                        <Button Command="{Binding SaveNewUomCommand}" Content="Save" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding UomRows, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsUomDto">
                                <Grid ColumnDefinitions="64,*,100">
                                    <TextBlock Text="{x:Bind Code}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Category}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=master_data_guide}">
                    <TextBlock FontWeight="SemiBold" Text="PartFinder master data" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Use Master Data in the main navigation for templates, catalogs and imports. Link worksheet rows to WMS SKUs through SKU identifier mapping (masterDataRow, partsRecord, manufacturerPn, ERP material)." />
                </StackPanel>

                <Grid
                    RowDefinitions="Auto,Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=stock_balances}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="180" ItemsSource="{Binding StockOwners, Mode=OneWay}" SelectedItem="{Binding FilterStockOwner, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Stock owner" />
                        <ComboBox Width="160" ItemsSource="{Binding Locations, Mode=OneWay}" SelectedItem="{Binding FilterLocation, Mode=TwoWay}" DisplayMemberPath="Path" PlaceholderText="Location" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding PrevBalancePageCommand}" Content="Previous" />
                        <Button Command="{Binding NextBalancePageCommand}" Content="Next" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding PaginationSummary, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="2" ItemsSource="{Binding BalanceRows, Mode=OneWay}" IsEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsBalanceRowDto">
                                <Grid ColumnDefinitions="130,*,80,80,80,48" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind SkuId}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind LocationId}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind OnHand}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Reserved}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Available}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind PrimaryUom}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ListView
                    IsEnabled="False"
                    ItemsSource="{Binding BalanceRows, Mode=OneWay}"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=location_stock}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:WmsBalanceRowDto">
                            <Grid ColumnDefinitions="*,80,80">
                                <TextBlock Text="{x:Bind LocationId}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SkuId}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind OnHand}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid
                    RowDefinitions="Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=movement_ledger}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding PrevTxnPageCommand}" Content="Previous" />
                        <Button Command="{Binding NextTxnPageCommand}" Content="Next" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding TransactionRows, Mode=OneWay}" IsEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsTransactionRowDto">
                                <Grid ColumnDefinitions="180,100,*,120">
                                    <TextBlock Text="{x:Bind TxnId}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Type}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CreatedBy}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=opening_preview}">
                    <TextBlock FontWeight="SemiBold" Text="Opening balance import preview (dry-run)" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding OpeningDryRunSummary, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    RowDefinitions="Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=mapping_errors}">
                    <ListView ItemsSource="{Binding MappingErrorRows, Mode=OneWay}" />
                    <ListView Grid.Row="1" ItemsSource="{Binding UnmappedRows, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:WmsUnmappedRowDisplay">
                                <TextBlock>
                                    <Run Text="{x:Bind PartName}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind PartId}" />
                                    <Run Text=" qty " />
                                    <Run Text="{x:Bind Quantity}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    RowDefinitions="Auto,Auto,*"
                    RowSpacing="8"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=expected_receipts}">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Expected receipt (draft)" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="180" ItemsSource="{Binding StockOwners, Mode=OneWay}" SelectedItem="{Binding DraftReceiptOwner, Mode=TwoWay}" DisplayMemberPath="Name" PlaceholderText="Stock owner" />
                            <TextBox Width="140" PlaceholderText="PO / external ref" Text="{Binding DraftExternalPoId, Mode=TwoWay}" />
                            <TextBox Width="120" PlaceholderText="Supplier ID" Text="{Binding DraftSupplierId, Mode=TwoWay}" />
                            <TextBox Width="160" PlaceholderText="Delivery note" Text="{Binding DraftSupplierNote, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding AddExpectedLineDraftRowCommand}" Content="Add line" IsEnabled="{Binding CanOperateReceiving, Mode=OneWay}" />
                            <Button Command="{Binding ImportExpectedLinesFromExcelAsyncCommand}" Content="Import Excel" IsEnabled="{Binding CanOperateReceiving, Mode=OneWay}" />
                            <Button Command="{Binding SaveExpectedReceiptCommand}" Content="Save" IsEnabled="{Binding CanOperateReceiving, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding ExpectedLineDrafts, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsExpectedLineDraftVm">
                                <Grid ColumnDefinitions="160,100,72,80" ColumnSpacing="8">
                                    <TextBox Text="{x:Bind SkuId, Mode=TwoWay}" PlaceholderText="SKU" />
                                    <NumberBox Grid.Column="1" Value="{x:Bind QtyExpected, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" Text="{x:Bind PrimaryUom, Mode=TwoWay}" PlaceholderText="UOM" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ValidationError, Mode=OneWay}" Foreground="OrangeRed" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView Grid.Row="2" ItemsSource="{Binding ExpectedReceiptRows, Mode=OneWay}" SelectedItem="{Binding SelectedExpectedReceipt, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsExpectedReceiptRowDto">
                                <Grid ColumnDefinitions="*,120,100">
                                    <TextBlock Text="{x:Bind ExpectedReceiptId}" FontFamily="Consolas" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ExternalPoId}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    RowDefinitions="Auto,Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=goods_receiving}">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Confirm physical receipt" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="180" ItemsSource="{Binding StockOwners, Mode=OneWay}" SelectedItem="{Binding DraftReceiptOwner, Mode=TwoWay}" DisplayMemberPath="Name" />
                            <ComboBox Width="200" ItemsSource="{Binding Locations, Mode=OneWay}" SelectedItem="{Binding DraftReceivingLocation, Mode=TwoWay}" DisplayMemberPath="Path" PlaceholderText="Receiving location" />
                            <Button Command="{Binding AddGoodsReceiptLineDraftRowCommand}" Content="Add line" IsEnabled="{Binding CanOperateReceiving, Mode=OneWay}" />
                            <Button Command="{Binding PasteGoodsReceiptLinesFromClipboardCommand}" Content="Paste" IsEnabled="{Binding CanOperateReceiving, Mode=OneWay}" />
                            <Button Command="{Binding ConfirmGoodsReceiptCommand}" Content="Confirm receipt" IsEnabled="{Binding CanOperateReceiving, Mode=OneWay}" />
                            <Button Command="{Binding SortReceivingListCommand}" CommandParameter="status" Content="Sort" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock VerticalAlignment="Center" Text="SKU col" />
                            <Slider Width="120" Minimum="80" Maximum="320" Value="{Binding ReceivingColSku, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Text="Qty col" />
                            <Slider Width="100" Minimum="60" Maximum="160" Value="{Binding ReceivingColQty, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding GoodsReceiptLineDrafts, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsGoodsReceiptLineDraftVm">
                                <Grid ColumnDefinitions="140,80,80,80,56,56,56" ColumnSpacing="6">
                                    <TextBox Text="{x:Bind SkuId, Mode=TwoWay}" Width="{Binding DataContext.ReceivingColSku, ElementName=PageRoot, Mode=OneWay}" />
                                    <NumberBox Grid.Column="1" Width="{Binding DataContext.ReceivingColQty, ElementName=PageRoot, Mode=OneWay}" Value="{x:Bind QtyReceived, Mode=TwoWay}" />
                                    <TextBox Grid.Column="2" Text="{x:Bind LotId, Mode=TwoWay}" PlaceholderText="Lot" />
                                    <TextBox Grid.Column="3" Text="{x:Bind SerialId, Mode=TwoWay}" PlaceholderText="Serial" />
                                    <CheckBox Grid.Column="4" Content="Dam" IsChecked="{x:Bind Damaged, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="5" Content="Short" IsChecked="{x:Bind Shortage, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="6" Content="Over" IsChecked="{x:Bind OverDelivery, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView Grid.Row="2" ItemsSource="{Binding GoodsReceiptRows, Mode=OneWay}" SelectedItem="{Binding SelectedGoodsReceipt, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsGoodsReceiptRowDto">
                                <Grid ColumnDefinitions="*,80,120">
                                    <TextBlock Text="{x:Bind GoodsReceiptId}" FontFamily="Consolas" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CreatedBy}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ListView
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=received_item_details}"
                    ItemsSource="{Binding ReceiptLineRows, Mode=OneWay}"
                    SelectedItem="{Binding SelectedReceiptLine, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:WmsReceiptLineRowDto">
                            <Grid ColumnDefinitions="*,80,80,80">
                                <TextBlock Text="{x:Bind SkuId}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind QtyReceived}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind QcStatus}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ReceiptLineId}" FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid
                    RowDefinitions="Auto,Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=quality_control}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox Width="100" Header="Accept" Value="{Binding QcQtyAccepted, Mode=TwoWay}" />
                            <NumberBox Width="100" Header="Reject" Value="{Binding QcQtyRejected, Mode=TwoWay}" />
                            <TextBox Width="200" PlaceholderText="Note" Text="{Binding QcNote, Mode=TwoWay}" />
                            <Button Command="{Binding ApplyQcDecisionCommand}" Content="Apply QC" IsEnabled="{Binding CanOperateQc, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Supervisor disposition (explicit write-off)" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox Width="90" Header="Qty" Value="{Binding DispositionQuantity, Mode=TwoWay}" />
                            <ComboBox Width="160" SelectedItem="{Binding DispositionType, Mode=TwoWay}">
                                <x:String>return_to_supplier</x:String>
                                <x:String>scrap</x:String>
                                <x:String>other</x:String>
                            </ComboBox>
                            <TextBox Width="200" PlaceholderText="Reason" Text="{Binding DispositionReason, Mode=TwoWay}" />
                            <Button Command="{Binding ConfirmDispositionCommand}" Content="Confirm disposition" />
                        </StackPanel>
                        <TextBlock Opacity="0.75" Text="Select a receipt line under Received Item Details first." TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView Grid.Row="2" ItemsSource="{Binding QcRows, Mode=OneWay}" SelectedItem="{Binding SelectedQcRow, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsQcRowDto">
                                <Grid ColumnDefinitions="*,120,80">
                                    <TextBlock Text="{x:Bind ReceiptLineId}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind QcId}" FontSize="10" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    RowDefinitions="Auto,*"
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=putaway_tasks}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="220" ItemsSource="{Binding Locations, Mode=OneWay}" SelectedItem="{Binding DraftPutawayToLocation, Mode=TwoWay}" DisplayMemberPath="Path" PlaceholderText="Storage location" />
                        <Button Command="{Binding CompletePutawayTaskCommand}" Content="Complete put-away" IsEnabled="{Binding CanOperatePutaway, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding PutawayRows, Mode=OneWay}" SelectedItem="{Binding SelectedPutawayTask, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsPutawayRowDto">
                                <Grid ColumnDefinitions="120,80,*,80">
                                    <TextBlock Text="{x:Bind SkuId}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind FromLocationId}" FontSize="11" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ListView
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=location_assignment}"
                    ItemsSource="{Binding PutawayRows, Mode=OneWay}"
                    SelectedItem="{Binding SelectedPutawayTask, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:WmsPutawayRowDto">
                            <TextBlock Text="{x:Bind SkuId}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=receiving_history}"
                    ItemsSource="{Binding ReceivingHistoryRows, Mode=OneWay}" IsEnabled="False" />
                <ListView
                    Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=receiving_discrepancies}"
                    ItemsSource="{Binding DiscrepancyRows, Mode=OneWay}" IsEnabled="False" />

                <StackPanel Visibility="{Binding SelectedSectionId, Mode=OneWay, Converter={StaticResource SectionVisConverter}, ConverterParameter=administration}" Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Administration" />
                    <TextBlock Text="{Binding CatalogPhaseSummary, Mode=OneWay}" />
                    <TextBlock Text="{Binding TransactionProbeSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="Staging gate" />
                    <TextBlock Text="{Binding ReceivingGateSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="220" PlaceholderText="Optional preflight note" Text="{Binding StagingPreflightNote, Mode=TwoWay}" />
                        <Button Command="{Binding RecordStagingPreflightCommand}" Content="Record preflight" IsEnabled="{Binding CanRecordStagingPreflight, Mode=OneWay}" />
                        <Button Command="{Binding RefreshReceivingWorksheetCommand}" Content="Refresh gate" />
                    </StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Operator grants" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="240" PlaceholderText="Operator email" Text="{Binding GrantOperatorEmail, Mode=TwoWay}" />
                        <CheckBox Content="Receiving" IsChecked="{Binding GrantPermReceiving, Mode=TwoWay}" />
                        <CheckBox Content="QC" IsChecked="{Binding GrantPermQc, Mode=TwoWay}" />
                        <CheckBox Content="Put-away" IsChecked="{Binding GrantPermPutaway, Mode=TwoWay}" />
                        <CheckBox Content="Supervise" IsChecked="{Binding GrantPermSupervise, Mode=TwoWay}" />
                        <Button Command="{Binding SaveOperatorGrantCommand}" Content="Save grant" IsEnabled="{Binding CanManageOperatorGrants, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Opacity="0.85" Text="Grant scope (required)" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <ItemsControl ItemsSource="{Binding GrantWarehouseScope, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:WmsGrantScopeRowVm">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding GrantOwnerScope, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:WmsGrantScopeRowVm">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ListView ItemsSource="{Binding OperatorGrantRows, Mode=OneWay}" MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsOperatorGrantDto">
                                <TextBlock Text="{x:Bind Email}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Opacity="0.75" Text="Staging gate evidence and stock flags remain server-side. Posted ledger rows are read-only." TextWrapping="Wrap" />
                </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <ProgressRing
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{Binding IsBusy, Mode=OneWay}"
            Width="48"
            Height="48" />
    </Grid>
</Page>