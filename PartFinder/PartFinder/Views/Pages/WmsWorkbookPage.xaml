<Page
    x:Class="PartFinder.Views.Pages.WmsWorkbookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:PartFinder.Services"
    x:Name="PageRoot">
    <Grid Padding="24" DataContext="{x:Bind ViewModel, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Warehouse Workbook (WMS Phase 02A)" />
            <TextBlock
                Opacity="0.75"
                Text="Setup masters via NestJS API. Legacy Inventory (tenant Mongo) is unchanged."
                TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TransactionProbeSummary, Mode=OneWay}" TextWrapping="Wrap" />
            <Button Command="{Binding RefreshCommand}" Content="Refresh" HorizontalAlignment="Left" />
        </StackPanel>

        <Pivot Grid.Row="1" Margin="0,16,0,0">
            <PivotItem Header="Warehouses">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Width="120">
                            <TextBlock Text="Code" />
                            <TextBox Text="{Binding NewWarehouseCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="240">
                            <TextBlock Text="Name" />
                            <TextBox Text="{Binding NewWarehouseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button VerticalAlignment="Bottom" Command="{Binding AddWarehouseCommand}" Content="Add" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding Warehouses, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsWarehouseDto">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Stock owners">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Width="120">
                            <TextBlock Text="Code" />
                            <TextBox Text="{Binding NewOwnerCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="240">
                            <TextBlock Text="Name" />
                            <TextBox Text="{Binding NewOwnerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button VerticalAlignment="Bottom" Command="{Binding AddStockOwnerCommand}" Content="Add" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding StockOwners, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:WmsStockOwnerDto">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Zones and locations">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <ComboBox
                        ItemsSource="{Binding Warehouses, Mode=OneWay}"
                        SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        Width="320"
                        HorizontalAlignment="Left" />

                    <StackPanel Grid.Row="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Width="120">
                                <TextBlock Text="Zone code" />
                                <TextBox Text="{Binding NewZoneCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="200">
                                <TextBlock Text="Zone name" />
                                <TextBox Text="{Binding NewZoneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button VerticalAlignment="Bottom" Command="{Binding AddZoneCommand}" Content="Add zone" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Width="160">
                                <TextBlock Text="Location path" />
                                <TextBox Text="{Binding NewLocationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="140">
                                <TextBlock Text="Type" />
                                <ComboBox SelectedItem="{Binding NewLocationType, Mode=TwoWay}">
                                    <x:String>receiving</x:String>
                                    <x:String>storage</x:String>
                                    <x:String>staging</x:String>
                                    <x:String>dispatch</x:String>
                                </ComboBox>
                            </StackPanel>
                            <Button VerticalAlignment="Bottom" Command="{Binding AddLocationCommand}" Content="Add location" IsEnabled="{Binding CanEditSetup, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
                        <ListView ItemsSource="{Binding Zones, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:WmsZoneDto">
                                    <TextBlock Text="{x:Bind Code}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ListView Grid.Column="1" ItemsSource="{Binding Locations, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:WmsLocationDto">
                                    <TextBlock Text="{x:Bind Path}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>

        <ProgressRing
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{Binding IsBusy, Mode=OneWay}"
            Width="48"
            Height="48" />
    </Grid>
</Page>