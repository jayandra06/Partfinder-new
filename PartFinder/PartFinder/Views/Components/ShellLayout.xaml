<UserControl
    x:Class="PartFinder.Views.Components.ShellLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PartFinder.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:PartFinder.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" />
    </UserControl.Resources>

    <!-- Root grid -->
    <Grid x:Name="RootGrid" RequestedTheme="Light" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- HEADER BAR (contains logo, brand, nav, bell, profile) -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border x:Name="ShellTitleBarRoot"
                Grid.Row="0"
                RequestedTheme="Light"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1"
                Padding="12,0,16,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: Logo + brand — sole title-bar drag region so nav/profile stay clickable -->
                <Grid x:Name="ShellTitleBarDragRegion"
                      Grid.Column="0"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="20"
                                Background="#F3F4F6">
                            <Image Source="ms-appx:///Assets/logo.png" Stretch="Uniform" Margin="5" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="PartFinder"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="#1F2937" />
                            <TextBlock Text="Inventory Management"
                                       FontSize="11"
                                       Foreground="#4B5563"
                                       CharacterSpacing="12"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- CENTER: Primary nav + More overflow (all icons together) -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ItemsRepeater
                        x:Name="NavListView"
                        ItemsSource="{Binding PrimaryNavigationItems}"
                        VerticalAlignment="Center">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:NavItemViewModel">
                                <Border Height="40"
                                        Padding="10,0"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        PointerEntered="OnNavItemPointerEntered"
                                        PointerExited="OnNavItemPointerExited"
                                        Tapped="OnNavItemTapped"
                                        Tag="{x:Bind Label}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon
                                            Glyph="{x:Bind IconGlyph}"
                                            FontSize="16"
                                            Foreground="#111827"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{x:Bind Label}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#111827"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button
                        x:Name="MoreNavButton"
                        Height="40"
                        Padding="10,0"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Foreground="#111827"
                        Visibility="{Binding HasOverflowNavigation, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="OnMoreNavButtonClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE712;" FontSize="16" Foreground="#111827" VerticalAlignment="Center" />
                            <TextBlock Text="More" FontSize="13" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- RIGHT: Profile card (sticky right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Padding="8,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1F2937"
                            ToolTipService.ToolTip="Profile menu"
                            x:Name="ProfileMenuButton">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        DataContext="{Binding ElementName=ProfileMenuButton, Path=DataContext}">
                                <Grid Width="28" Height="28">
                                    <Border CornerRadius="14"
                                            Background="{StaticResource AccentPrimaryBrush}"
                                            Visibility="{Binding HasUserAvatar, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding CurrentUserInitial}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="14"
                                            Visibility="{Binding HasUserAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CurrentUserAvatarSource}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock VerticalAlignment="Center" FontSize="13"
                                           Foreground="#1F2937"
                                           Text="{Binding CurrentUserName}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="90" />
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE70D;" FontSize="11" Foreground="#4B5563" />
                            </StackPanel>
                        </Button.Content>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Account Settings" Click="OnAccountSettingsMenuClicked" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Log out" Click="OnProfileLogoutMenuClicked" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- CONTENT FRAME — full width now                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Frame x:Name="ContentFrame"
               Grid.Row="1"
               RequestedTheme="Light"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- TOOLTIP OVERLAY — shows below nav icons on hover    -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border x:Name="NavTooltipOverlay"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Canvas.ZIndex="999">
            <Canvas>
                <Border x:Name="NavTooltipBox"
                        Background="#FFFFFF"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,7"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="NavTooltipLabel"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937" />
                </Border>
            </Canvas>
        </Border>

    </Grid>
</UserControl>
