<UserControl
    x:Class="PartFinder.Views.Components.InventoryItemFormPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    MinWidth="440">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="0,0,4,0">
            <StackPanel Spacing="4">
                <TextBlock Text="PART NAME *" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="PartNameBox" Style="{StaticResource StandardTextBoxStyle}" PlaceholderText="e.g. Turbocharger Assembly" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="PART ID" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="PartIdBox" Style="{StaticResource StandardTextBoxStyle}" PlaceholderText="e.g. TRB-2024-001" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="CATEGORY" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="CategoryBox" Style="{StaticResource StandardTextBoxStyle}" PlaceholderText="e.g. Engine Parts" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="SUPPLIER" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="SupplierBox" Style="{StaticResource StandardTextBoxStyle}" PlaceholderText="e.g. Global Parts Inc" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="LOCATION" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="LocationBox" Style="{StaticResource StandardTextBoxStyle}" PlaceholderText="e.g. Warehouse A, Shelf 3" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="QUANTITY *" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="QuantityBox" Style="{StaticResource StandardTextBoxStyle}" PlaceholderText="e.g. 100" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="MIN STOCK THRESHOLD" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="MinStockBox" Style="{StaticResource StandardTextBoxStyle}" PlaceholderText="e.g. 10" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="UNIT PRICE ($)" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="UnitPriceBox" Style="{StaticResource StandardTextBoxStyle}" PlaceholderText="e.g. 1250.00" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="NOTES (OPTIONAL)" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" />
                <TextBox x:Name="NotesBox"
                         Style="{StaticResource StandardTextBoxStyle}"
                         PlaceholderText="Any additional notes..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="70" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
