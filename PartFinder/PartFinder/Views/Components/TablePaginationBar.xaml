<UserControl
    x:Class="PartFinder.Views.Components.TablePaginationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12,10"
        BorderBrush="{StaticResource BorderDefaultBrush}"
        BorderThickness="0,1,0,0"
        Background="Transparent">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{Binding PaginationSummary, Mode=OneWay}"
                FontSize="11"
                Foreground="{StaticResource TextSecondaryBrush}"
                VerticalAlignment="Center" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Style="{StaticResource OutlinedButtonStyle}"
                    FontSize="11"
                    Padding="10,4"
                    Content="Previous"
                    Command="{Binding GoToPreviousPageCommand}"
                    IsEnabled="{Binding CanGoToPreviousPage, Mode=OneWay}" />
                <Button
                    Style="{StaticResource OutlinedButtonStyle}"
                    FontSize="11"
                    Padding="10,4"
                    Content="Next"
                    Command="{Binding GoToNextPageCommand}"
                    IsEnabled="{Binding CanGoToNextPage, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
