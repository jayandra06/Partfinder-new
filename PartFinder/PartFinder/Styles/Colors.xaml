<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Backgrounds -->
            <Color x:Key="PageBackgroundColor">#50070C14</Color>
            <Color x:Key="CardBackgroundColor">#B8141D2A</Color>
            <Color x:Key="ElevatedCardBackgroundColor">#D81A2637</Color>
            <Color x:Key="InputBackgroundColor">#96111A27</Color>
            <Color x:Key="GridHeaderBackgroundColor">#B21C2C40</Color>
            <Color x:Key="GridRowAltBackgroundColor">#660E1520</Color>
            <Color x:Key="ShellSurfaceColor">#A1162130</Color>
            <Color x:Key="ShellSidebarColor">#8C0B1220</Color>
            <Color x:Key="GlassStrokeColor">#4CF4F8FF</Color>
            <Color x:Key="GlassStrongStrokeColor">#66B8D3FF</Color>
            <Color x:Key="GlassHighlightColor">#22FFFFFF</Color>
            <Color x:Key="AmbientBlueColor">#332F7FD2</Color>
            <Color x:Key="AmbientPurpleColor">#2E8B5CF6</Color>
            <Color x:Key="AmbientPinkColor">#26F472B6</Color>

            <!-- Interactive states -->
            <Color x:Key="RowHoverBackgroundColor">#7A213047</Color>
            <Color x:Key="RowSelectedBackgroundColor">#A01D456C</Color>
            <Color x:Key="RowSelectedBorderColor">#7DB8FF</Color>

            <!-- Accent -->
            <Color x:Key="AccentPrimaryColor">#5EA2FF</Color>
            <Color x:Key="AccentHoverColor">#7CB7FF</Color>
            <Color x:Key="AccentPressedColor">#2F75D6</Color>

            <!-- Text -->
            <Color x:Key="TextPrimaryColor">#F4F8FF</Color>
            <Color x:Key="TextSecondaryColor">#C4D0DF</Color>
            <Color x:Key="TextTertiaryColor">#93A6C0</Color>
            <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

            <!-- Borders -->
            <Color x:Key="BorderDefaultColor">#406884A8</Color>
            <Color x:Key="BorderHoverColor">#7A9CC2E8</Color>
            <Color x:Key="BorderFocusColor">#BDD8FF</Color>

            <!-- Semantic -->
            <Color x:Key="SuccessColor">#38D6A4</Color>
            <Color x:Key="WarningColor">#FFC98D</Color>
            <Color x:Key="DangerColor">#FFB4C7</Color>
            <Color x:Key="InfoColor">#B8D6FF</Color>

            <!-- Navigation -->
            <Color x:Key="NavBackgroundColor">#8C0B1220</Color>
            <Color x:Key="NavItemHoverColor">#29243A57</Color>
            <Color x:Key="NavItemSelectedColor">#664A95E8</Color>
            <Color x:Key="NavItemSelectedBorderColor">#995EA2FF</Color>
            <Color x:Key="HeaderBarBackgroundColor">#CC111A27</Color>
            <Color x:Key="ChartSurfaceBackgroundColor">#141D2A</Color>
            <Color x:Key="ContentShellBackgroundColor">#96111A27</Color>

            <!-- Backward-compatible aliases -->
            <Color x:Key="AppPrimaryColor">#5EA2FF</Color>
            <Color x:Key="AppBackgroundColor">#50070C14</Color>
            <Color x:Key="AppSurfaceColor">#A1162130</Color>
            <Color x:Key="AppTextColor">#F4F8FF</Color>
            <Color x:Key="AppBorderColor">#406884A8</Color>
            <Color x:Key="AppSkeletonColor">#26FFFFFF</Color>
            <Color x:Key="AppSubtleTextColor">#C4D0DF</Color>

            <BitmapImage
                x:Key="PartFinderLogoImage"
                UriSource="ms-appx:///Assets/PartFinderLogo-Darkmode.png"
                DecodePixelWidth="512" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Backgrounds — layered cool gray-blue (canvas → cards → elevated) -->
            <Color x:Key="PageBackgroundColor">#FFD8E1EC</Color>
            <Color x:Key="CardBackgroundColor">#FFF0F4FA</Color>
            <Color x:Key="ElevatedCardBackgroundColor">#FFFBFCFE</Color>
            <Color x:Key="InputBackgroundColor">#FFEEF2F8</Color>
            <Color x:Key="GridHeaderBackgroundColor">#FFC5D6EA</Color>
            <Color x:Key="GridRowAltBackgroundColor">#99E2E9F3</Color>
            <Color x:Key="ShellSurfaceColor">#FFE8EDF5</Color>
            <Color x:Key="ShellSidebarColor">#FFDCE4EF</Color>
            <Color x:Key="GlassStrokeColor">#5A8AA4C4</Color>
            <Color x:Key="GlassStrongStrokeColor">#6E81A9D8</Color>
            <Color x:Key="GlassHighlightColor">#55FFFFFF</Color>
            <Color x:Key="AmbientBlueColor">#3A3878C8</Color>
            <Color x:Key="AmbientPurpleColor">#348B5CF6</Color>
            <Color x:Key="AmbientPinkColor">#30E879A8</Color>

            <!-- Interactive states -->
            <Color x:Key="RowHoverBackgroundColor">#E4F0FA</Color>
            <Color x:Key="RowSelectedBackgroundColor">#CCE4F8FF</Color>
            <Color x:Key="RowSelectedBorderColor">#5EA2FF</Color>

            <!-- Accent -->
            <Color x:Key="AccentPrimaryColor">#2F7FD2</Color>
            <Color x:Key="AccentHoverColor">#4A95E8</Color>
            <Color x:Key="AccentPressedColor">#1F64B2</Color>

            <!-- Text — higher contrast on light surfaces -->
            <Color x:Key="TextPrimaryColor">#0B1220</Color>
            <Color x:Key="TextSecondaryColor">#2C3B4F</Color>
            <Color x:Key="TextTertiaryColor">#4A5C73</Color>
            <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

            <!-- Borders -->
            <Color x:Key="BorderDefaultColor">#66A8BDD8</Color>
            <Color x:Key="BorderHoverColor">#8D7FA6D6</Color>
            <Color x:Key="BorderFocusColor">#2F7FD2</Color>

            <!-- Semantic -->
            <Color x:Key="SuccessColor">#0FAF7A</Color>
            <Color x:Key="WarningColor">#DB8B14</Color>
            <Color x:Key="DangerColor">#D95879</Color>
            <Color x:Key="InfoColor">#3D86E8</Color>

            <!-- Navigation -->
            <Color x:Key="NavBackgroundColor">#FFDCE4EF</Color>
            <Color x:Key="NavItemHoverColor">#D8E4F2FF</Color>
            <Color x:Key="NavItemSelectedColor">#402F7FD2</Color>
            <Color x:Key="NavItemSelectedBorderColor">#662F7FD2</Color>
            <Color x:Key="HeaderBarBackgroundColor">#E8EEF4F9</Color>
            <Color x:Key="ChartSurfaceBackgroundColor">#FFF0F4FA</Color>
            <Color x:Key="ContentShellBackgroundColor">#FFD8E1EC</Color>

            <!-- Backward-compatible aliases -->
            <Color x:Key="AppPrimaryColor">#2F7FD2</Color>
            <Color x:Key="AppBackgroundColor">#FFD8E1EC</Color>
            <Color x:Key="AppSurfaceColor">#FFE8EDF5</Color>
            <Color x:Key="AppTextColor">#0B1220</Color>
            <Color x:Key="AppBorderColor">#66A8BDD8</Color>
            <Color x:Key="AppSkeletonColor">#2E7FA6D6</Color>
            <Color x:Key="AppSubtleTextColor">#2C3B4F</Color>

            <BitmapImage
                x:Key="PartFinderLogoImage"
                UriSource="ms-appx:///Assets/PartFinderLogo-Lightmode.png"
                DecodePixelWidth="512" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Brushes are painted by ThemeService for the active theme. Defaults match dark mode. -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#50070C14" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B8141D2A" />
    <SolidColorBrush x:Key="ElevatedCardBackgroundBrush" Color="#D81A2637" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#96111A27" />
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#B21C2C40" />
    <SolidColorBrush x:Key="GridRowAltBackgroundBrush" Color="#660E1520" />
    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#A1162130" />
    <SolidColorBrush x:Key="ShellSidebarBrush" Color="#8C0B1220" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#4CF4F8FF" />
    <SolidColorBrush x:Key="GlassStrongStrokeBrush" Color="#66B8D3FF" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="RowHoverBackgroundBrush" Color="#7A213047" />
    <SolidColorBrush x:Key="RowSelectedBackgroundBrush" Color="#A01D456C" />
    <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#7DB8FF" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#5EA2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7CB7FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F75D6" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F8FF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C4D0DF" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#93A6C0" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#406884A8" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#7A9CC2E8" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#BDD8FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#38D6A4" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC98D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFB4C7" />
    <SolidColorBrush x:Key="InfoBrush" Color="#B8D6FF" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#8C0B1220" />
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#29243A57" />
    <SolidColorBrush x:Key="NavItemSelectedBrush" Color="#664A95E8" />
    <SolidColorBrush x:Key="NavItemSelectedBorderBrush" Color="#995EA2FF" />
    <SolidColorBrush x:Key="HeaderBarBackgroundBrush" Color="#CC111A27" />
    <SolidColorBrush x:Key="ChartSurfaceBackgroundBrush" Color="#141D2A" />
    <SolidColorBrush x:Key="ContentShellBackgroundBrush" Color="#96111A27" />
    <SolidColorBrush x:Key="WindowRootBackgroundBrush" Color="#FF0A0E15" />
    <SolidColorBrush x:Key="AmbientBlueBrush" Color="#332F7FD2" />
    <SolidColorBrush x:Key="AmbientPurpleBrush" Color="#2E8B5CF6" />
    <SolidColorBrush x:Key="AmbientPinkBrush" Color="#26F472B6" />

    <LinearGradientBrush x:Key="AccentHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7CB7FF" Offset="0" />
        <GradientStop Color="#5EA2FF" Offset="0.55" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <!-- Backward-compatible aliases. ThemeService repaints these with the active theme. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#50070C14" />
    <SolidColorBrush x:Key="AppSidebarBrush" Color="#8C0B1220" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#A1162130" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#406884A8" />
    <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#C4D0DF" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#F4F8FF" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#38D6A4" />
    <SolidColorBrush x:Key="AppSkeletonBrush" Color="#26FFFFFF" />
</ResourceDictionary>
