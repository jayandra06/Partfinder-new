<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- When Windows is in dark mode, WinUI still resolves Dark Fluent tokens for some controls.
         Override Dark theme tokens so inputs, combos, and standard buttons stay light with dark text. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="TextFillColorPrimary">#E4000000</Color>
            <Color x:Key="TextFillColorSecondary">#9E000000</Color>
            <Color x:Key="TextFillColorTertiary">#72000000</Color>
            <Color x:Key="TextFillColorDisabled">#5C000000</Color>
            <Color x:Key="TextFillColorInverse">#FFFFFF</Color>

            <Color x:Key="ControlFillColorDefault">#FFFFFFFF</Color>
            <Color x:Key="ControlFillColorSecondary">#FFF9FAFB</Color>
            <Color x:Key="ControlFillColorTertiary">#FFF3F4F6</Color>
            <Color x:Key="ControlFillColorDisabled">#FFF3F4F6</Color>
            <Color x:Key="ControlFillColorInputActive">#FFFFFFFF</Color>
            <Color x:Key="ControlSolidFillColorDefault">#FFFFFFFF</Color>

            <Color x:Key="ControlStrokeColorDefault">#FFD1D5DB</Color>
            <Color x:Key="ControlStrokeColorSecondary">#FF9CA3AF</Color>
            <Color x:Key="FocusStrokeColorOuter">#FF1F7AE0</Color>

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />

            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFD1D5DB" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFD1D5DB" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF1F7AE0" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9CA3AF" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF111827" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFD1D5DB" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FF6B7280" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF4B5563" />
            <SolidColorBrush x:Key="ComboBoxPlaceholderForeground" Color="#FF9CA3AF" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF1F2937" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFD1D5DB" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF1F7AE0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF155DAF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF0E3F78" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF1F7AE0" />
        </ResourceDictionary>

        <!-- Same light input chrome when effective theme is Light/Default (template canvas, etc.) -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFD1D5DB" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF1F7AE0" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF111827" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFD1D5DB" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FF6B7280" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF4B5563" />
            <SolidColorBrush x:Key="ComboBoxPlaceholderForeground" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF111827" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFD1D5DB" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF1F7AE0" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9CA3AF" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFF9FAFB" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF111827" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFD1D5DB" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF4B5563" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Fallback: WinUI templates resolve these before themed variants on some builds. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF9FAFB" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#FF111827" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFD1D5DB" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF111827" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFD1D5DB" />
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#FF4B5563" />
</ResourceDictionary>
